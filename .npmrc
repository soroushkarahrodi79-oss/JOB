# Dependency and supply-chain resilience — D15 / ADR-0008.
# Exact versions are pinned so the committed lockfile is the single source of truth.
save-exact=true
# The Node engine range in package.json is enforced, not advisory.
engine-strict=true
# Peer dependencies are installed automatically and recorded in the lockfile.
auto-install-peers=true
# CI passes --frozen-lockfile explicitly; it is not forced here so that adding a
# justified dependency locally remains possible.
